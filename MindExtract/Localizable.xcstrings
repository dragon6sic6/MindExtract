        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fler Whisper-modeller"
          }
        }
      }
    },
    "Most videos download without signing in. Sign in only if YouTube blocks one — age-restricted or members-only videos, for example.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De flesta videor går att hämta utan inloggning. Logga bara in om YouTube stoppar en, till exempel åldersbegränsade videor eller videor för medlemmar."
          }
        }
      }
    },
