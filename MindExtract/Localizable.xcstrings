      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter en inspelning"
          }
        }
      }
    },
    "After allowing meeting audio in System Settings, restart MindExtract.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta om MindExtract när du har tillåtit mötesljud i Systeminställningar."
