          "stringUnit": {
            "state": "translated",
            "value": "Ladda även ned undertexter"
          }
        }
      }
    },
    "Always Pianissimo when it's downloaded — the best at Swedish.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltid Pianissimo när den är nedladdad – bäst på svenska."
          }
        }
      }
    },
    "Always ask for consent before recording others.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Be alltid om samtycke innan du spelar in andra."
          }
        }
      }
    },
    "Anna Lindqvist": {},
    "Answers": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar"
          }
        }
      }
    },
    "Answers cite which transcript they came from. Try:": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaren anger vilket transkript de kommer från. Prova:"
          }
        }
      }
    },
