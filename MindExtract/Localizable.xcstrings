    "Accessibility": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälpmedel"
          }
        }
      }
    },
    "Accessibility lets MindExtract notice the key and type into other apps — it never reads what you type. Shortcuts like ⌥2 for @ keep working. Audio is discarded right after.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälpmedel låter MindExtract känna av tangenten och skriva i andra appar – det du skriver läses aldrig. Kortkommandon som ⌥2 för @ fungerar som vanligt. Ljudet kastas direkt efteråt."
          }
        }
      }
    },
    "Acknowledgements": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack till"
          }
        }
      }
    },
