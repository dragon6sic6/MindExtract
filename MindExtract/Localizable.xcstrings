        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiera utan tidsstämplar"
          }
        }
      }
    },
    "Everything here runs on your Mac. Nothing is uploaded.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt här körs på din Mac. Inget laddas upp."
