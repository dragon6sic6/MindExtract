        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken skärm notchen ska finnas på när du har flera."
          }
        }
      }
    },
    "Whisper: downloadable models that handle the most languages.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper: nedladdningsbara modeller som klarar flest språk."
          }
        }
      }
    },
    "Without a Dock icon, this keeps the notch there after a restart.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan Dock-ikon ser det till att notchen finns kvar efter en omstart."
