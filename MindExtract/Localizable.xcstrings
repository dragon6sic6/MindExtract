      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara ljud"
          }
        }
      }
    },
    "Audio tools are missing — transcription is unavailable": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudverktyg saknas – transkribering är inte tillgänglig"
          }
        }
      }
    },
    "Audio tools are missing, so transcription is unavailable. Reinstall MindExtract to fix it.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudverktyg saknas, så transkribering är inte tillgänglig. Installera om MindExtract för att åtgärda det."
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiskt"
          }
        }
      }
    },
    "Automatic detects the language of each recording. You can always transcribe again in another language.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiskt känner av språket i varje inspelning. Du kan alltid transkribera igen på ett annat språk."
          }
        }
      }
    },
    "Automatic follows your Mac's light or dark mode and accent color.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiskt följer din Macs ljusa eller mörka läge och accentfärg."
          }
        }
      }
    },
    "Available when the transcript is ready": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillgängligt när transkriptet är klart"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillbaka"
