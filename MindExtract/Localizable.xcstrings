      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga vad som helst om alla transkript du har sparat."
          }
        }
      }
    },
    "Ask anything and follow-up email": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga vad som helst och uppföljningsmejl"
          }
        }
      }
    },
