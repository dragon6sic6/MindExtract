    },
    "%@ call": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-samtal"
          }
        }
      }
    },
    "%@ isn't set up — pick a ready model or configure it in Settings": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är inte konfigurerad – välj en modell som är redo eller ställ in den i Inställningar"
          }
        }
      }
    },
    "%@ meeting": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-möte"
          }
        }
      }
    },
    "%@ · %@ download": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ att ladda ned"
          }
        }
      }
    },
    "%@%@": {},
    "%@, downloaded once, then works offline. Until then Swedish uses a less accurate engine.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, laddas ned en gång och fungerar sedan offline. Tills dess används en mindre noggrann motor för svenska."
          }
        }
      }
    },
    "%@, once. You can keep using MindExtract meanwhile.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, en gång. Du kan använda MindExtract under tiden."
          }
        }
      }
    },
    "%lld": {},
