    "%@ (%@) downloads once, then works offline.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) laddas ned en gång och fungerar sedan utan internet."
          }
        }
      }
    },
    "%@ (Text)": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (text)"
          }
        }
      }
    },
