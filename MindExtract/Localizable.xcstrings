      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte"
          }
        }
      }
    },
    "That isn't a link. Paste a web address or drag a file here.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är ingen länk. Klistra in en webbadress eller dra hit en fil."
          }
        }
      }
    },
    "The download stopped moving. Check your connection and try again.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedladdningen har stannat. Kontrollera anslutningen och försök igen."
          }
        }
      }
    },
    "The selected quality isn't available for this video. Try a different format.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valda kvaliteten finns inte för den här videon. Prova ett annat format."
