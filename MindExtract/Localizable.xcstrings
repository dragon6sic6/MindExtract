{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "\n\n": {},
    "%@ (%@) downloads once, then works offline.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) laddas ned en gång och fungerar sedan utan internet."
          }
        }
      }
    },
    "%@ (Swedish only)": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (bara svenska)"
          }
        }
      }
    },
    "%@ (Swedish), %@": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (svenska), %@"
          }
        }
      }
    },
