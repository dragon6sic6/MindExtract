      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utseende"
          }
        }
      }
    },
    "Apple": {},
    "Apple speech recognition": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples taligenkänning"
          }
        }
      }
    },
    "Apple's built-in speech recognition. No download needed.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples inbyggda taligenkänning. Inget behöver laddas ned."
          }
        }
      }
    },
    "Apple's speech recognition doesn't support %@. Download a speech model in Settings → Transcription and try again.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples taligenkänning stöder inte %@. Ladda ned en talmodell i Inställningar → Transkribering och försök igen."
          }
        }
      }
    },
    "Apple: built into macOS, no download. Falls back to Whisper for languages Apple can't do.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple: inbyggd i macOS, ingen nedladdning. Använder Whisper för språk som Apple inte klarar."
          }
        }
      }
    },
    "Ask": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga"
          }
        }
      }
    },
    "Ask AI across all transcripts": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga AI om alla transkript"
          }
        }
      }
    },
    "Ask About This": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga om det här"
          }
        }
      }
    },
    "Ask Claude about your meetings — catch up, prepare for a person, turn tasks into tickets. Read-only; Claude only sees what you ask about.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga Claude om dina möten – kom ikapp, förbered dig inför någon, gör uppgifter till ärenden. Bara läsning; Claude ser bara det du frågar om."
          }
        }
      }
    },
    "Ask about anything you've recorded…": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga om vad som helst du har spelat in…"
          }
        }
      }
    },
    "Ask about this transcript…": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga om transkriptet…"
          }
        }
