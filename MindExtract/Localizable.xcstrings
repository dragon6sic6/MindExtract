        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom, Teams, Meet med flera – även i webbläsaren. Kontrollerar bara vilken app som använder mikrofonen, aldrig vad som sägs."
          }
        }
      }
    },
