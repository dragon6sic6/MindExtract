    "About": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om"
          }
        }
      }
    },
    "Apple: built into macOS, no download. Whisper takes over for languages Apple can't do.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple: inbyggd i macOS, ingen nedladdning. Whisper tar över för språk som Apple inte klarar."
          }
        }
      }
    },
    "Automatic detects the language of each video. You can pick another one in the notch before transcribing.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiskt känner av språket i varje video. Du kan välja ett annat i notchen innan du transkriberar."
          }
        }
      }
    },
    "Bigger is more accurate but slower.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Större är noggrannare men långsammare."
          }
        }
      }
    },
    "Borrows the sign-in from a browser on this Mac.": {
      "localizations": {
